    "lexical": "0.52.0",
    "node-pty": "^1.1.0",
    "playwright-core": "1.58.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sqlite-vec": "0.1.9",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
