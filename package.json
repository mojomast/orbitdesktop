{
  "name": "orbit-desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "node scripts/isolated_build.mjs",
    "start": "node --experimental-strip-types server/index.mjs",
    "up": "node scripts/orbit-up.mjs",
    "test": "node scripts/check-local.mjs test",
    "check": "node scripts/check-local.mjs check",
    "format": "prettier --write src server tests docs README.md package.json index.html vite.config.js tsconfig.json"
  },
  "dependencies": {
    "@a2ui/lit": "0.12.0",
    "@a2ui/markdown-it": "0.2.0",
    "@a2ui/web_core": "0.12.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@huggingface/transformers": "4.3.0",
    "@lexical/clipboard": "0.52.0",
    "@lexical/code": "0.52.0",
    "@lexical/history": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@xterm/addon-fit": "^0.10.0",
