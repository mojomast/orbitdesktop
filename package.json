{
  "name": "orbit-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-strip-types server/index.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "node scripts/generate-workspace-contract.mjs --check && npm run build && npm test",
    "format": "prettier --write src server tests docs README.md package.json index.html vite.config.js tsconfig.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.11.1",
    "dockview-core": "8.3.1",
    "node-pty": "^1.1.0",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
