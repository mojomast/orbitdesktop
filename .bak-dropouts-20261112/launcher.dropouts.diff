+async def _lag_probe(L, every=5.0):
+    """Event-loop lag (how late a 5 s sleep wakes up), reported by /v1/health."""
+    while True:
+        t = time.monotonic(); await asyncio.sleep(every)
+        L.loop_lag_ms = max(0.0, (time.monotonic() - t - every) * 1000)
