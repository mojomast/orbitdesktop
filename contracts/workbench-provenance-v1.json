{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "initiated_by": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "native_agent"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            },
            "grant_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            },
            "tool_call_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            }
          },
          "required": [
            "kind",
            "attempt_id",
            "grant_id",
            "run_id",
            "tool_call_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "owner_action"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "legacy_unknown"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "authorized_by": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "owner_grant"
            },
            "grant_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            },
            "authority_generation": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            }
          },
          "required": [
            "kind",
            "grant_id",
            "authority_generation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "owner_approval"
            },
            "preview_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
            }
          },
          "required": [
            "kind",
            "preview_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "legacy_unknown"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "recorded_by": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "comet_service"
            },
            "component": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "build_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "verifier_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "verifier_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "component",
            "build_id",
            "verifier_id",
            "verifier_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "legacy_unknown"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "version",
    "initiated_by",
    "authorized_by",
    "recorded_by"
  ],
  "additionalProperties": false
}
