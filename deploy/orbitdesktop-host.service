[Unit]
Description=Comet Orbit Desktop - mojo host workspace
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/mojo/.hermes-instances/fresh/workspace/orbitdesktop
EnvironmentFile=/home/mojo/.hermes-instances/fresh/workspace/orbitdesktop/.env.deploy
Environment=HOME=/home/mojo
Environment=SHELL=/bin/bash
ExecStart=/usr/bin/node --experimental-strip-types server/index.mjs
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
