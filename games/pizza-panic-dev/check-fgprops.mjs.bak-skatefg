// Check for the foreground parallax props (baba_booey, t_1ad03aea0ea3452a):
// sprites exist and stay lean, every walking level (sewer, street, skate, subway,
// rooftop, harbor, tower) has a sparse deterministic themed set, the layer runs at
// ~1.4x (far 0.2x / mid 1x / fore 1.4x), props fade over fighters, Reduced motion
// turns the layer off, and in the real game every level draws its props with
// 0 console errors. Screenshots + contact sheet -> /workspace/pizza-fgprops/shots.
// usage: node check-fgprops.mjs [shots dir]
import { createRequire } from 'node:module';
import http from 'node:http'; import fs from 'node:fs'; import path from 'node:path'; import { execFileSync } from 'node:child_process';
const require = createRequire('/home/box/orbitdesktop/package.json');
const { chromium } = require('playwright-core');
const ROOT = new URL('../pizza-panic/', import.meta.url).pathname;
const SH = process.argv[2] || '/workspace/pizza-fgprops/shots'; fs.mkdirSync(SH, { recursive: true });
let fails = 0; const ok = (c, m) => { console.log((c ? 'PASS ' : 'FAIL ') + m); if (!c) fails++; };
const P = await import(path.join(ROOT, 'parallax.js'));
const NAMES = { 0: 'sewer', 1: 'street', 3: 'skate', 5: 'subway', 2: 'rooftop', 6: 'harbor', 4: 'tower' };
const LEVELS = [0, 1, 3, 5, 2, 6, 4];
// --- static -----------------------------------------------------------------
const dir = path.join(ROOT, 'assets/levels/fg'); let total = 0, bad = [];
for (const k of Object.keys(P.FG_KINDS)) { const f = path.join(dir, k + '.png'); if (!fs.existsSync(f)) { bad.push(k); continue; } const b = fs.readFileSync(f); total += b.length; if (b.readUInt32BE(0) !== 0x89504e47 || b.length > 60 * 1024) bad.push(k); }
ok(Object.keys(P.FG_KINDS).length >= 21 && !bad.length && total < 600 * 1024, `${Object.keys(P.FG_KINDS).length} prop sprites in assets/levels/fg, each PNG <= 60 KB, ${Math.round(total / 1024)} KB total (< 600) ${bad.join(',')}`);
ok(P.FG_RATE >= 1.3 && P.FG_RATE <= 1.5 && P.FAR_RATE < 0.5, `speeds: far ${P.FAR_RATE}x, mid 1x, fore ${P.FG_RATE}x`);
for (const lv of LEVELS) {
  const L = P.FG[lv] || [], kinds = new Set(L.map(p => p.k));
  const gaps = L.slice(1).map((p, i) => p.x - L[i].x), top = L.filter(p => p.top).length, bottom = L.length - top;
  const span = lv === 3 ? P.SKATE_PERIOD : 5442 * P.FG_RATE;
  ok(L.length >= 3 && L.every(p => P.FG_KINDS[p.k]) && Math.min(...gaps) >= 600 && L.length <= Math.ceil(span / 600) && top >= 1 + (lv === 3 ? -1 : 0) && bottom >= 1 && kinds.size >= 3,
    `${NAMES[lv]}: ${L.length} props (${bottom} bottom, ${top} top), ${kinds.size} kinds [${[...kinds].join(', ')}], min gap ${Math.min(...gaps)} fg px`);
}
ok(!(P.FG[7] && P.FG[7].length), 'arcade (7) keeps its own props, no foreground layer');
{ const again = await import(path.join(ROOT, 'parallax.js') + '?again'); ok(JSON.stringify(again.FG) === JSON.stringify(P.FG), 'placement is deterministic (same layout on a fresh import)'); }
{ const px = P.createParallax(); const a = px.placements(1, 1000, 740), b = px.placements(1, 1100, 740);
  const m = a.map(p => [p, b.find(q => q.id === p.id)]).filter(([, q]) => q).map(([p, q]) => (p.sx - q.sx) / 100);
  ok(m.length && m.every(v => Math.abs(v - P.FG_RATE) < 1e-6), `fore props move ${m[0]}x the camera (mid moves 1x)`); }
// --- browser ----------------------------------------------------------------
const types = { '.js': 'text/javascript', '.html': 'text/html', '.png': 'image/png', '.jpg': 'image/jpeg', '.json': 'application/json', '.mp3': 'audio/mpeg', '.ogg': 'audio/ogg', '.wav': 'audio/wav' };
const server = http.createServer((q, r) => { if (q.url.startsWith('/favicon')) { r.writeHead(204); return r.end(); } const f = path.join(ROOT, decodeURIComponent(q.url.split('?')[0]).replace(/\/$/, '/index.html')); if (!f.startsWith(ROOT) || !fs.existsSync(f)) { r.writeHead(404); return r.end(); } r.writeHead(200, { 'content-type': types[path.extname(f)] || 'application/octet-stream' }); fs.createReadStream(f).pipe(r); });
await new Promise(res => server.listen(0, '127.0.0.1', res));
const url = `http://127.0.0.1:${server.address().port}/`;
const errors = []; let phase = 'boot';
const browser = await chromium.launch({ executablePath: '/usr/bin/google-chrome', args: ['--autoplay-policy=no-user-gesture-required'] });
const page = await browser.newPage({ viewport: { width: 740, height: 510 } });
page.on('console', m => { if (m.type() === 'error') errors.push(`[${phase}] ` + m.text().split('\n')[0]); });
page.on('pageerror', e => errors.push(`[${phase}] ` + String(e).split('\n')[0]));
page.on('response', r => { if (r.status() >= 400) errors.push(`[${phase}] HTTP ${r.status()} ${r.url()}`); });
const shots = [];
// the onboarding coach cards (check-coach) are already acknowledged here, so they don't cover the shots
await page.addInitScript(() => { try { localStorage.setItem('pizzaPanicCoachDone', '1'); } catch (_) {} });
try {
  await page.goto(url); await page.waitForTimeout(1200);
  for (let i = 0; i < 80 && !(await page.evaluate(() => window.__ppSelect?.active)); i++) { await page.keyboard.press('KeyX'); await page.waitForTimeout(150); }
  await page.keyboard.press('Enter'); await page.waitForTimeout(400);
  for (let i = 0; i < 10 && await page.evaluate(() => window.__ppCinema?.isActive?.()); i++) { await page.keyboard.press('Escape'); await page.waitForTimeout(250); }
  ok(await page.evaluate(() => !!window.__ppParallax && Object.keys(window.__ppParallax.images).filter(k => k.startsWith('fg_') && !k.endsWith('_err')).length >= 21), 'all prop sprites loaded in the game');
  const clearOverlays = async () => {
    for (let i = 0, idle = 0; i < 60 && idle < 4; i++) {
      const what = await page.evaluate(() => { const b = window.__ppBonus; if (b && b.active()) { try { b.close(); } catch (_) {} return 'bonus'; }
        const sh = window.__ppShop; if (sh && sh.active()) { try { sh.leave(); } catch (_) {} return 'shop'; }
        if (window.__ppPause?.isOpen?.()) { window.__ppPause.close(); return 'pause'; }
        if (window.__ppScreens?.active?.()) return 'screen'; if (window.__ppCinema?.isActive?.()) return 'cine'; return null; });
      if (what === 'screen') await page.keyboard.press('Enter'); else if (what === 'cine') await page.keyboard.press('Escape');
      idle = what ? 0 : idle + 1; await page.waitForTimeout(200);
    }
  };
  // move the hero until fg prop p sits at screen x `at` (the camera has a dead-zone, so iterate)
  const frame = async (lv, p, at) => {
    const id = lv === 3 ? null : String(P.FG[lv].indexOf(p));
    let x = Math.max(0, (p.x - at) / P.FG_RATE) + 370, r = null;
    await page.evaluate(async lv => { const E = await import('./events.js'); const s = window.__ppState; s.level = lv; s.ninjas = []; s.invuln = 999; s.hp = s.maxHp; s.holdWave = true; s.walkLevel = true;
      for (const b of E.TRIGGERS) if (b.level === s.level) s.events.fired[b.level + ':' + b.x] = true; s.events.lock = null; s.events.camX = null; s.events.cooldown = 0; }, lv);
    for (let it = 0; it < 4; it++) {
      let last = -1e9;
      for (let t = 0; t < 30; t++) {
        await page.evaluate(x => { const st = window.__ppState, q = st.player; q.x = x; q.y = 400; if (st.harbor) { st.harbor.px = x; st.harbor.sv = 0; } }, x);
        await page.waitForTimeout(75); const cam = await page.evaluate(() => window.__ppCamX); if (t > 4 && Math.abs(cam - last) < 1) break; last = cam;
      }
      await page.waitForTimeout(60);
      r = await page.evaluate(([lv, id]) => { const px = window.__ppParallax, cam = window.__ppCamX, pl = px.placements(lv, cam, 740).find(q => q.id === id); return { cam: Math.round(cam), sx: pl ? Math.round(pl.sx) : null, hero: Math.round(window.__ppState.player.x - cam), ...px.stats(), level: window.__ppState.level, overlay: !!window.__ppScreens?.active?.() }; }, [lv, id]);
      if (r.sx == null || Math.abs(r.sx - at) < 30) break;
      x = Math.max(0, x + (r.sx - at) / P.FG_RATE);
    }
    return r;
  };
  // frame a prop beside the hero (not over him), so it shows at full strength
  const frameClear = async (lv, p) => { let r = await frame(lv, p, 590); if (r.faded) r = await frame(lv, p, r.hero > 370 ? r.hero - 300 : r.hero + 300); return r; };
  for (const lv of LEVELS) {
    phase = NAMES[lv];
    await page.evaluate(async lv => { const L = await import('./logic.js'); const s = window.__ppState; s.ninjas = []; s.wave = L.LEVEL_ORDER.indexOf(lv) + 1; s.level = lv; s.holdWave = true; s.invuln = 999; s.player.x = 200; }, lv);
    for (let i = 0; i < 40 && (await page.evaluate(() => window.__ppState.level)) !== lv; i++) { await page.waitForTimeout(150); await page.keyboard.press('Enter'); }
    await clearOverlays();
    const list = P.FG[lv], pick = lv === 3 ? [] : [list.find(p => !p.top && p.x > 900), list.find(p => p.top && p.x > 900)].filter(Boolean);
    let drew = 0, n = 0;
    if (lv === 3) { // skate: the run scrolls on its own; just sample frames
      for (let i = 0; i < 6; i++) { await page.waitForTimeout(450); const st = await page.evaluate(() => window.__ppParallax.stats()); drew = Math.max(drew, st.shown); if (st.shown && n < 2) { const f = `${SH}/fg-skate-${n++}.png`; await page.screenshot({ path: f }); shots.push(f); } }
      if (!n) { const f = `${SH}/fg-skate-0.png`; await page.screenshot({ path: f }); shots.push(f); }
    } else for (const p of pick) {
      if (await page.evaluate(lv => window.__ppState.level !== lv || !!window.__ppScreens?.active?.(), lv)) { await clearOverlays(); }
      const r = await frameClear(lv, p);
      drew = Math.max(drew, r.shown);
      const f = `${SH}/fg-${NAMES[lv]}-${p.k}${p.top ? '-top' : ''}.png`; await page.screenshot({ path: f }); shots.push(f);
      if (!(r.shown >= 1) || r.faded) console.log('   diag', NAMES[lv], p.k, JSON.stringify(r));
    }
    ok(drew >= 1 && (await page.evaluate(() => window.__ppState.level)) === lv, `${NAMES[lv]}: the foreground layer draws its props in the game (${drew} on screen at once)`);
  }
  // fade over fighters: a bottom prop right on top of the hero goes nearly transparent
  phase = 'fade';
  { const lv = 1, p = P.FG[1].find(q => !q.top && q.x > 900); const r = await frame(lv, p, 590);
    // same frame drawn into a scratch canvas with the hero under the prop vs. far from it (enemies cleared)
    const t = await page.evaluate(([lv, sx]) => { const px = window.__ppParallax, s = window.__ppState; s.ninjas = []; const c = document.createElement('canvas'); c.width = 740; c.height = 510; const g = c.getContext('2d');
      const run = hx => { let st; for (let i = 0; i < 20; i++) { px.front(g, lv, window.__ppCamX, 740, 510, hx, 340); st = px.stats(); } return st; };
      return { far: run(sx > 370 ? 60 : 680), over: run(sx) }; }, [lv, r.sx]);
    await page.evaluate(x => { window.__ppState.player.x = window.__ppCamX + x; }, r.sx); await page.waitForTimeout(400);
    const f = `${SH}/fg-street-fade-over-hero.png`; await page.screenshot({ path: f }); shots.push(f);
    ok(t.over.shown >= 1 && t.over.faded >= 1 && t.far.faded === 0, `a prop over a fighter fades out (far: ${t.far.faded}/${t.far.shown} faded, over: ${t.over.faded}/${t.over.shown})`); }
  // Reduced motion (pipi/Hermes options.js): no foreground layer
  phase = 'reduced';
  { await page.evaluate(async () => (await import('./options-live.js')).OPTIONS.set('reducedMotion', true)); await page.waitForTimeout(250);
    const st = await page.evaluate(() => window.__ppParallax.stats());
    await page.evaluate(async () => (await import('./options-live.js')).OPTIONS.set('reducedMotion', false)); await page.waitForTimeout(250);
    const st2 = await page.evaluate(() => window.__ppParallax.stats());
    ok(st.reduced && st.shown === 0 && !st2.reduced && st2.shown >= 1, `Reduced motion hides the layer (on: ${st.shown} shown, off: ${st2.shown})`); }
  ok(errors.length === 0, `0 console errors (${errors.length}) ${errors.slice(0, 3).join(' | ')}`);
} catch (e) { ok(false, 'browser: ' + (e && e.stack || e)); }
await browser.close(); server.close();
try { execFileSync('python3', ['-c', `
import sys
from PIL import Image, ImageDraw
fs=sys.argv[1:]; cols=4; w,h=370,255; rows=(len(fs)+cols-1)//cols
s=Image.new('RGB',(cols*w,rows*(h+18)),(12,12,16)); d=ImageDraw.Draw(s)
for i,f in enumerate(fs):
  im=Image.open(f).convert('RGB').resize((w,h)); x,y=(i%cols)*w,(i//cols)*(h+18); s.paste(im,(x,y+18)); d.text((x+4,y+3),f.split('/')[-1][3:-4],fill=(255,230,100))
s.save('${SH}/fg-contact-sheet.png')`, ...shots]); console.log('contact sheet ' + SH + '/fg-contact-sheet.png'); } catch (e) { console.log('contact sheet failed: ' + e.message); }
console.log(fails ? `${fails} fgprops checks FAILED` : 'all fgprops checks passed');
process.exit(fails ? 1 : 0);
