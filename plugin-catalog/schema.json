{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomast/orbitdesktop/plugin-catalog/schema.json",
  "title": "Orbit community plugin catalog entry",
  "description": "Machine-readable reference for plugin-catalog/<id>.json. scripts/orbit_catalog.py::validate is the admission source of truth and reuses the publisher's exact bounded config-schema validator. This file, removed.json and non-entry files are never treated as entries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "description", "category", "maintainer", "license", "repo", "sha", "path", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,25}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 400 },
    "category": { "type": "string", "minLength": 1, "maxLength": 40 },
    "maintainer": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "repo": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 200 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "storage"],
      "properties": { "network": { "type": "boolean" }, "storage": { "type": "boolean" } }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "runtime", "permissions"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 200 },
        "runtime": { "const": "python3" },
        "permissions": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "configSchema": {
      "description": "Optional bounded inline widget config metadata. Same closed shape as src/plugin-config-schema.ts; no regex, template, URL or executable content.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "type"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,47}$" },
              "type": { "enum": ["string", "number", "boolean"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "description": { "type": "string", "maxLength": 200 },
              "default": { "anyOf": [{ "type": "string", "maxLength": 4096 }, { "type": "number" }, { "type": "boolean" }] },
              "enum": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "anyOf": [{ "type": "string", "maxLength": 4096 }, { "type": "number" }, { "type": "boolean" }] }
              },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
